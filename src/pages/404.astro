---
import Layout from "../layouts/Layout.astro";
import Image from "astro/components/Image.astro";
---
<Layout title="Heyner Javier Marmol - @javymarmol" description="Full Stack and Android Developer" image="">
        <div class="grid h-screen place-content-center px-4">
            <div class="text-center">

                <Image

                        width="300"
                        height="300"
                        src="/me.webp"
                        loading={"eager"}
                        class="w-auto max-h-[300px] select-none absolute right-[-110px] bottom-[-20px] z-[-1] opacity-50 md:opacity-100 md:relative md:right-auto md:bottom-auto md:z-auto pointer-events-none"
                        alt="memoji of javymarmol"
                />
                <h1 class="text-9xl font-black text-gray-200">404</h1>
                
                <div id="404-en" class="hidden">
                    <p class="text-2xl font-bold tracking-tight text-gray-300 sm:text-4xl">Uh-oh!</p>
                    <p class="mt-4 text-gray-500">We can't find that page.</p>
                    <a
                            href="/en/"
                            class="mt-6 inline-block rounded bg-cyan-500 px-5 py-3 text-sm font-medium text-white
                     hover:bg-cyan-700 focus:outline-none focus:ring"
                    >
                        Go Back Home
                    </a>
                </div>

                <div id="404-es" class="hidden">
                    <p class="text-2xl font-bold tracking-tight text-gray-300 sm:text-4xl">¡Oh no!</p>
                    <p class="mt-4 text-gray-500">No podemos encontrar esa página.</p>
                    <a
                            href="/es/"
                            class="mt-6 inline-block rounded bg-cyan-500 px-5 py-3 text-sm font-medium text-white
                     hover:bg-cyan-700 focus:outline-none focus:ring"
                    >
                        Volver al Inicio
                    </a>
                </div>

                <script is:inline>
                  try {
                    const isSpanish = window.location.pathname.startsWith('/es/');
                    if (isSpanish) {
                      document.documentElement.setAttribute('lang', 'es');
                      document.getElementById('404-es').classList.remove('hidden');
                    } else {
                      document.documentElement.setAttribute('lang', 'en');
                      document.getElementById('404-en').classList.remove('hidden');
                    }
                  } catch (e) {
                    document.getElementById('404-en').classList.remove('hidden');
                  }
                </script>
            </div>
        </div>
</Layout>
