---
import Card from "./Card/index.astro";
import { useTranslations, type Locale } from "../libs/i18n";
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-6" title={t('about_me_title')}>
  <div class="flex flex-col gap-2">
    <div class="text-sm font-light">
      <p>
        {t('about_me_desc_1')}
      </p>
      <p>
        {t('about_me_desc_2')}
      </p>
    </div>

    <div class="text-sm font-light">
    <p>
      {t('about_me_stack')}
    </p>
    <h3>{t('backend')}</h3>
    <ul class="list-disc list-inside">
      <li>Laravel</li>
      <li>NodeJS</li>
      <li>.Net Core</li>
    </ul>
    <h3>{t('frontend')}</h3>
    <ul class="list-disc list-inside">
      <li>React</li>
      <li>Vue</li>
    </ul>

    <h3>{t('android')}</h3>
    <ul class="list-disc list-inside">
      <li>Kotlin</li>
      <li>Java</li>
    </ul>
    </div>
  </div>
</Card>
